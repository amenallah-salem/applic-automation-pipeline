# Copy this file to `.env` before running `docker compose up`.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=applications
POSTGRES_PORT=5432

# --- Networking / host --------------------------------------------------
# Single source of truth for the host the BROWSER uses to reach this stack.
# Every browser-facing URL (frontend -> backend, n8n webhooks, openwebui
# redirects) and the backend CORS whitelist all derive from this.
# Valid values: `localhost`, `127.0.0.1`, or a LAN IP like `192.168.1.50`.
# Must match whatever you actually type in the browser address bar.
# (0.0.0.0 is a LISTEN address only — the containers already listen on
# 0.0.0.0 internally; don't put 0.0.0.0 here, browsers can't fetch from it.)
#
# Changing APP_HOST requires rebuilding the frontend (the URL is baked in):
#   docker compose up -d --build frontend backend
APP_HOST=localhost

# The following are normally left UNSET — they're derived from APP_HOST +
# the *_PORT variables below. Only set them if you need something unusual
# (e.g. the browser hits a reverse proxy on a different host/port than the
# container ports).
# VITE_API_BASE_URL=http://localhost:8000
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# WEBHOOK_URL=http://localhost:5678/
# WEBUI_URL=http://localhost:3001

# --- Backend (FastAPI) -----------------------------------------------------
BACKEND_PORT=8000

# --- Frontend (React + nginx) ---------------------------------------------
FRONTEND_PORT=3000

# --- OpenWebUI -------------------------------------------------------------
OPENWEBUI_PORT=3001
OPENWEBUI_DB=openwebui
# Generate with: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=change-me-to-a-long-random-string
# Open WebUI is built from source (see openwebui/). Pin to a release tag
# (e.g. v0.5.20) once you find one that works for you, or leave as `main`.
OPENWEBUI_REF=main
# Big-file handling for RAG uploads (see openwebui/README.md).
RAG_FILE_MAX_SIZE=500
RAG_FILE_MAX_COUNT=50

# --- n8n -------------------------------------------------------------------
N8N_PORT=5678
N8N_DB=n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# --- Misc ------------------------------------------------------------------
TZ=UTC
