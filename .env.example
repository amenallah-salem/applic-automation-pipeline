# Copy this file to `.env` before running `docker compose up`.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=applications
POSTGRES_PORT=5432

# --- Networking / host --------------------------------------------------
# What the BROWSER uses to reach the backend. This URL is baked into the
# frontend JS at build time, so it MUST match whatever you type in the
# browser address bar when opening the dashboard.
#   - If you open http://localhost:3000    -> http://localhost:8000
#   - If you open http://127.0.0.1:3000    -> http://127.0.0.1:8000
#   - If you open http://192.168.x.y:3000  -> http://192.168.x.y:8000
# After changing this you MUST rebuild the frontend:
#   docker compose build frontend && docker compose up -d frontend
VITE_API_BASE_URL=http://localhost:8000

# JSON array of origins the backend's CORS middleware will allow. Include
# every scheme+host+port your browser may load the frontend from. Mismatch
# here causes "NetworkError when attempting to fetch resource" in the UI.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Backend (FastAPI) -----------------------------------------------------
BACKEND_PORT=8000

# --- Frontend (React + nginx) ---------------------------------------------
FRONTEND_PORT=3000

# --- OpenWebUI -------------------------------------------------------------
OPENWEBUI_PORT=3001
OPENWEBUI_DB=openwebui
# Generate with: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=change-me-to-a-long-random-string
# Open WebUI is built from source (see openwebui/). Pin to a release tag
# (e.g. v0.5.20) once you find one that works for you, or leave as `main`.
OPENWEBUI_REF=main
# Big-file handling for RAG uploads (see openwebui/README.md).
RAG_FILE_MAX_SIZE=500
RAG_FILE_MAX_COUNT=50

# --- n8n -------------------------------------------------------------------
N8N_PORT=5678
N8N_DB=n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# --- Misc ------------------------------------------------------------------
TZ=UTC
