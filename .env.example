# Copy this file to `.env` before running `docker compose up`.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=applications
POSTGRES_PORT=5432

# --- Backend (FastAPI) -----------------------------------------------------
BACKEND_PORT=8000

# --- Frontend (React + nginx) ---------------------------------------------
FRONTEND_PORT=3000

# --- OpenWebUI -------------------------------------------------------------
OPENWEBUI_PORT=3001
OPENWEBUI_DB=openwebui
# Generate with: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=change-me-to-a-long-random-string

# --- n8n -------------------------------------------------------------------
N8N_PORT=5678
N8N_DB=n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# --- Misc ------------------------------------------------------------------
TZ=UTC
